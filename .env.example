# Copy this file to .env.local and fill in the values.
# IMPORTANT: never commit .env.local — it is gitignored.

# Turso (libSQL) — generate a NEW token before using this app.
#   turso db tokens revoke <old-token-name>
#   turso db tokens create hr-andreh
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Resend (optional — booking confirmation emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL="HR+ <reservas@hrworldfood.es>"

# Public site URL (used by SEO + canonical links)
NEXT_PUBLIC_SITE_URL=https://hrworldfood.es

# Qoorder storefront URL — gestor externo de pedidos (delivery)
NEXT_PUBLIC_QOORDER_URL=https://qoorder.com/r/hr-world-food

# Google Places — reseñas reales (sin estas dos vars la sección entra en
# modo fallback minimalista sin reseñas individuales).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
